Type: Package
Package: lingamr
Title: LiNGAM Algorithms for Causal Discovery
Version: 0.1.2.9000
Authors@R: c(
    person("Osamu", "Morimoto", , "galactic.supermarket@gmail.com", role = c("aut", "cre", "cph")),
    person("T.", "Ikeuchi", role = "cph"),
    person("G.", "Haraoka", role = "cph"),
    person("M.", "Ide", role = "cph"),
